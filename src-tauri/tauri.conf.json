{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bookmark Overlay",
  "version": "0.1.0",
  "identifier": "io.github.noxfly.bookmark-overlay",
  "build": {
    "frontendDist": "../frontend/public",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bookmark Overlay",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Dorian Thivolle",
    "shortDescription": "Overlay de consultation du référentiel clients",
    "longDescription": "Retrouver un client et ouvrir sa ressource (Azure DevOps, GitHub, Admin Center Business Central, dossiers locaux) depuis un panneau appelé par un raccourci global.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
